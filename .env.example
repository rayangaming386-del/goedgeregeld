# ──────────────────────────────────────────────────────────────────────────
# Goed Geregeld Autoverhuur — omgevingsvariabelen
# Kopieer naar .env en vul in. Zet .env nooit in git.
# ──────────────────────────────────────────────────────────────────────────

# PostgreSQL 15+ (de migraties gebruiken de extensie btree_gist).
# Op Vercel zet de Neon-koppeling DATABASE_URL (via de pooler) en
# DATABASE_URL_UNPOOLED (direct; gebruikt voor migraties) zelf.
DATABASE_URL=postgres://gebruiker:wachtwoord@127.0.0.1:5432/goedgeregeld
# DATABASE_URL_UNPOOLED=
# Aparte database voor de integratietests (wordt bij elke test geleegd!).
TEST_DATABASE_URL=postgres://gebruiker:wachtwoord@127.0.0.1:5432/goedgeregeld_test
# Optioneel: maximaal aantal databaseverbindingen per proces (standaard 10).
# DATABASE_POOL_MAX=10

# Geheim voor HMAC (rate limiting, dubbele-aanvraagcontrole). Minimaal 32 tekens.
# Genereer bijvoorbeeld met: openssl rand -base64 48
APP_SECRET=

# Definitieve domeinnaam, zonder slash aan het eind. Pas invullen als het
# domein vaststaat: zonder SITE_URL geen canonieke adressen en geen sitemap,
# en de website blijft niet-vindbaar.
# SITE_URL=https://www.voorbeeld.nl

# Aantal vertrouwde proxy’s vóór de app (voor het bepalen van het IP-adres bij
# rate limiting). 1 = Vercel of één nginx/load balancer (standaard).
# TRUSTED_PROXY_HOPS=1

# Sessiecookie: standaard alleen via HTTPS in productie (__Host-cookie).
# Alleen voor lokaal testen van een productiebuild over http:
# SESSION_COOKIE_SECURE=false

# ─── Foto-opslag ───────────────────────────────────────────────────────────
# Zonder MEDIA_STORAGE: `database` op Vercel, anders `local`.
#
# local: bestanden op schijf (één server of VPS). Originelen staan in een
# aparte, niet-publieke map; alleen webvarianten worden via /media/… geserveerd.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./storage

# database: bestanden in PostgreSQL (tabel media_objects), geserveerd via
# /media/… met CDN-caching. Nodig op Vercel (geen blijvende schijf); voor vier
# auto’s ruim voldoende (startinhoud ±21 MB). Originelen blijven privé.
# MEDIA_STORAGE=database

# s3: S3-compatibele opslag (AWS S3, Cloudflare R2, MinIO). Klaar voor
# aansluiting, nog niet getest tegen een echte bucket. De bucket mag alleen
# de map variants/ publiek maken; originals/ moet privé blijven.
# MEDIA_STORAGE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=goedgeregeld-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.voorbeeld.nl

# ─── E-mailmelding bij een nieuwe aanvraag (optioneel) ──────────────────────
# Zonder deze instellingen worden aanvragen alleen in het beheer getoond.
# De melding bevat geen klantgegevens, alleen het aanvraagnummer en een link.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=Goed Geregeld <aanvragen@voorbeeld.nl>
# MAIL_TO=eigenaar@voorbeeld.nl

# ─── Eerste account bij de installatie ──────────────────────────────────────
# pnpm db:seed maakt hiermee een eigenaar-account. Bij een deployment
# (pnpm deploy:prepare, op Vercel automatisch) alleen zolang er nog geen enkel
# account is, en dan moet het wachtwoord bij de eerste login gewijzigd worden.
# Daarna weer verwijderen. Wachtwoord minimaal 12 tekens.
# SEED_OWNER_EMAIL=
# SEED_OWNER_NAME=
# SEED_OWNER_PASSWORD=

# Wachtwoord voor `pnpm user:create` zonder prompt (optioneel; anders wordt
# om een wachtwoord gevraagd of een tijdelijk wachtwoord gemaakt).
# NEW_USER_PASSWORD=

# Alleen om in productie bewust alle data te wissen met `pnpm db:seed --reset --yes`.
# ALLOW_RESET=1
